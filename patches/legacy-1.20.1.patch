@@ -0,0 +1,95 @@
+/*
+ * This file is part of the Meteor Client distribution (https://github.com/MeteorDevelopment/meteor-client).
+ * Copyright (c) Meteor Development.
+ */
+
+package meteordevelopment.meteorclient.utils.misc;
+
+import meteordevelopment.meteorclient.MeteorClient;
+import meteordevelopment.meteorclient.systems.config.Config;
+
+import java.nio.charset.StandardCharsets;
+import java.util.AbstractList;
+import java.util.ArrayList;
+import java.util.List;
+
+public final class Splashes {
+    private static final String BLOCK_RESOURCE = "/assets/meteor-client/tr/splash.txt";
+    private static final String CUSTOM_RESOURCE = "/assets/meteor-client/tr/splash_custom.txt";
+
+    private static List<String> block;
+    private static List<String> custom;
+
+    private Splashes() {}
+
+    public static boolean hasCustom() {
+        load();
+        return !custom.isEmpty();
+    }
+
+    public static List<String> list(List<String> fallback) {
+        return new Pool(fallback);
+    }
+
+    private static boolean customEnabled() {
+        Config config = Config.get();
+        return config != null && config.customSplashes != null && config.customSplashes.get();
+    }
+
+    private static synchronized void load() {
+        if (block != null) return;
+
+        block = lines(BLOCK_RESOURCE);
+        custom = lines(CUSTOM_RESOURCE);
+
+        MeteorClient.LOG.info("Loaded {} block splashes and {} custom splashes", block.size(), custom.size());
+    }
+
+    private static List<String> lines(String resource) {
+        List<String> result = new ArrayList<>();
+
+        byte[] bytes = Tr.read(resource);
+        if (bytes == null) return result;
+
+        for (String line : new String(bytes, StandardCharsets.UTF_8).split("\\R")) {
+            line = line.strip();
+            if (!line.isEmpty() && !line.startsWith("#")) result.add(line);
+        }
+
+        return result;
+    }
+
+    private static final class Pool extends AbstractList<String> {
+        private final List<String> fallback;
+
+        private Pool(List<String> fallback) {
+            this.fallback = fallback;
+        }
+
+        @Override
+        public String get(int index) {
+            return current().get(index);
+        }
+
+        @Override
+        public int size() {
+            return current().size();
+        }
+
+        private List<String> current() {
+            try {
+                if (!Tr.enabled()) return fallback;
+
+                load();
+
+                List<String> pool = new ArrayList<>(block);
+                if (customEnabled()) pool.addAll(custom);
+
+                return pool.isEmpty() ? fallback : pool;
+            } catch (Exception e) {
+                MeteorClient.LOG.error("Failed to build the splash pool", e);
+                return fallback;
+            }
+        }
+    }
+}
diff --git a/src/main/java/meteordevelopment/meteorclient/utils/misc/Tr.java b/src/main/java/meteordevelopment/meteorclient/utils/misc/Tr.java
new file mode 100644
index 0000000..aeb7ebd
--- /dev/null
+++ b/src/main/java/meteordevelopment/meteorclient/utils/misc/Tr.java
@@ -0,0 +1,109 @@
+/*
+ * This file is part of the Meteor Client distribution (https://github.com/MeteorDevelopment/meteor-client).
+ * Copyright (c) Meteor Development.
+ */
+
+package meteordevelopment.meteorclient.utils.misc;
+
+import com.google.gson.JsonElement;
+import com.google.gson.JsonObject;
+import com.google.gson.JsonParser;
+import meteordevelopment.meteorclient.MeteorClient;
+
+import java.io.InputStream;
+import java.io.InputStreamReader;
+import java.nio.charset.StandardCharsets;
+import java.util.Collection;
+import java.util.HashMap;
+import java.util.Map;
+
+public final class Tr {
+    private static final String DICTIONARY = "/assets/meteor-client/tr/zh_tw.json";
+    private static final Map<String, String> TRANSLATIONS = new HashMap<>();
+    private static boolean loaded;
+
+    private Tr() {}
+
+    public static boolean enabled() {
+        String forced = System.getProperty("meteor.zhtw");
+        if (forced != null) return Boolean.parseBoolean(forced);
+
+        if (MeteorClient.mc == null || MeteorClient.mc.options == null) return false;
+
+        String code = MeteorClient.mc.options.language;
+        return "zh_tw".equals(code) || "zh_hk".equals(code);
+    }
+
+    public static String t(String text) {
+        if (text == null || text.isEmpty() || !enabled()) return text;
+        if (!loaded) load();
+
+        String translated = TRANSLATIONS.get(text);
+        return translated != null ? translated : text;
+    }
+
+    public static Object[] args(Object[] args) {
+        if (args == null || !enabled()) return args;
+
+        Object[] translated = args.clone();
+        for (int i = 0; i < translated.length; i++) {
+            if (translated[i] instanceof String text) translated[i] = argument(text);
+        }
+
+        return translated;
+    }
+
+    public static boolean hasCjk(String text) {
+        if (text == null) return false;
+
+        for (int i = 0; i < text.length(); i++) {
+            char c = text.charAt(i);
+            if (c >= 0x2E80 && c <= 0x9FFF || c >= 0xFF00 && c <= 0xFFEF) return true;
+        }
+
+        return false;
+    }
+
+    static Collection<String> translations() {
+        if (!loaded) load();
+        return TRANSLATIONS.values();
+    }
+
+    static byte[] read(String path) {
+        try (InputStream in = Tr.class.getResourceAsStream(path)) {
+            return in == null ? null : in.readAllBytes();
+        } catch (Exception e) {
+            return null;
+        }
+    }
+
+    private static String argument(String text) {
+        int start = 0;
+        while (start + 1 < text.length() && text.charAt(start) == '\u00A7') start += 2;
+
+        String body = text.substring(start);
+        String translated = t(body);
+
+        return translated == body ? text : text.substring(0, start) + translated;
+    }
+
+    private static synchronized void load() {
+        if (loaded) return;
+        loaded = true;
+
+        try (InputStream in = Tr.class.getResourceAsStream(DICTIONARY)) {
+            if (in == null) {
+                MeteorClient.LOG.warn("Missing translation file {}", DICTIONARY);
+                return;
+            }
+
+            JsonObject json = JsonParser.parseReader(new InputStreamReader(in, StandardCharsets.UTF_8)).getAsJsonObject();
+            for (Map.Entry<String, JsonElement> entry : json.entrySet()) {
+                String value = entry.getValue().getAsString();
+                if (!value.isEmpty()) TRANSLATIONS.put(entry.getKey(), value);
+            }
+        } catch (Exception e) {
+            MeteorClient.LOG.error("Failed to load {}", DICTIONARY, e);
+        }
+    }
+}
