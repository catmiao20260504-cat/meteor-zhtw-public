@@ -0,0 +1,72 @@
+/*
+ * This file is part of the Meteor Client distribution (https://github.com/MeteorDevelopment/meteor-client).
+ * Copyright (c) Meteor Development.
+ */
+
+package meteordevelopment.meteorclient.utils.misc;
+
+import org.lwjgl.BufferUtils;
+import org.lwjgl.stb.STBTTFontinfo;
+import org.lwjgl.stb.STBTruetype;
+
+import java.nio.ByteBuffer;
+import java.util.ArrayList;
+import java.util.List;
+import java.util.TreeSet;
+
+public final class CjkFont {
+    private static final String RESOURCE = "/assets/meteor-client/tr/cjk.ttf";
+    private static final String SYMBOLS = "\u2026\u2014\u2013\u00B7\u2022\u00D7\u00F7\u00B0\u00B1\u2264\u2265\u2248\u2190\u2192\u2191\u2193";
+
+    private static ByteBuffer buffer;
+    private static boolean bufferLoaded;
+    private static int[] codepoints;
+
+    private CjkFont() {}
+
+    public static boolean available() {
+        return buffer() != null;
+    }
+
+    public static boolean shouldUseCustom(boolean customFontSetting) {
+        return Tr.enabled() ? available() : customFontSetting;
+    }
+
+    public static synchronized ByteBuffer buffer() {
+        if (!bufferLoaded) {
+            bufferLoaded = true;
+
+            byte[] bytes = Tr.read(RESOURCE);
+            if (bytes != null) {
+                buffer = BufferUtils.createByteBuffer(bytes.length);
+                buffer.put(bytes);
+                buffer.flip();
+            }
+        }
+
+        return buffer;
+    }
+
+    public static synchronized int[] codepoints() {
+        if (codepoints != null) return codepoints;
+
+        ByteBuffer font = buffer();
+        if (font == null) return codepoints = new int[0];
+
+        STBTTFontinfo info = STBTTFontinfo.create();
+        if (!STBTruetype.stbtt_InitFont(info, font)) return codepoints = new int[0];
+
+        TreeSet<Integer> wanted = new TreeSet<>();
+        for (String value : Tr.translations()) value.codePoints().filter(c -> c > 0x7F).forEach(wanted::add);
+        for (int c = 0x3000; c <= 0x303F; c++) wanted.add(c);
+        for (int c = 0xFF01; c <= 0xFF5E; c++) wanted.add(c);
+        for (char c : SYMBOLS.toCharArray()) wanted.add((int) c);
+
+        List<Integer> available = new ArrayList<>();
+        for (int c : wanted) {
+            if (STBTruetype.stbtt_FindGlyphIndex(info, c) != 0) available.add(c);
+        }
+
+        return codepoints = available.stream().mapToInt(Integer::intValue).toArray();
+    }
+}
